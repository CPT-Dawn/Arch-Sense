# Maintainer: CPT_Dawn <dev@cptdawn.dev>
#
# Builds Arch-Sense from the repository this PKGBUILD lives in (run makepkg from
# packaging/aur/arch-sense). Release CI swaps that for the tagged tarball.
# ./check.sh runs the packaging checks; ./check.sh --build also builds.

pkgname=arch-sense
pkgver=1.3.2
pkgrel=1
pkgdesc="Control center for Linuwu-Sense Acer laptops: thermal profiles, fans, battery and keyboard lighting"
arch=('x86_64')
url="https://github.com/CPT-Dawn/Arch-Sense"
license=('MIT')
depends=('linuwu-sense-dkms-git' 'libusb' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('nvidia-utils: GPU temperature via nvidia-smi when hwmon has no GPU sensor')
install=arch-sense.install
source=(
  'arch-sense.service'
  'arch-sense.sysusers'
  'arch-sense.tmpfiles'
  '71-arch-sense.rules'
)
sha256sums=('83d09216c08fce5b1e4ddbfd12809370244c8bd970e5e93409422d4b1fac0b4e'
            'fda5d014e6980d2ae73a42366182fb46337022c0588a6e81c7635651673c6d67'
            '3bb028afeba660ee71b8510a05ef848d2700597b6083873578488fe9742cf3c1'
            '6552f52d9ffdd527f968e008fae47342d95309f868296f8190a43cb939ae7e74')

_tree="$startdir/../../.."

prepare() {
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --manifest-path "$_tree/Cargo.toml" --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release --manifest-path "$_tree/Cargo.toml"
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --manifest-path "$_tree/Cargo.toml"
}

package() {
  install -Dm755 "$srcdir/target/release/arch-sense" "$pkgdir/usr/bin/arch-sense"
  install -Dm644 arch-sense.service "$pkgdir/usr/lib/systemd/system/arch-sense.service"
  install -Dm644 arch-sense.sysusers "$pkgdir/usr/lib/sysusers.d/arch-sense.conf"
  install -Dm644 arch-sense.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/arch-sense.conf"
  install -Dm644 71-arch-sense.rules "$pkgdir/usr/lib/udev/rules.d/71-arch-sense.rules"
  install -Dm644 "$_tree/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
